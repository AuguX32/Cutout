{
  "name": "cutout-brutal",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite --host 127.0.0.1",
    "desktop": "electron .",
    "test": "node --test desktop/store.test.cjs desktop/generation.test.cjs photo-pixels.test.js context-fill.test.js",
    "dist:mac": "vite build && electron-builder --mac dmg --arm64 --x64 --publish never",
    "dist:win": "vite build && electron-builder --win dir --x64 --publish never && node scripts/build-windows-installer.mjs",
    "test:editor": "node tests/editor-smoke.cjs"
  },
  "dependencies": {
    "@imgly/background-removal": "1.7.0",
    "@techstark/opencv-js": "5.0.0-release.1",
    "@tensorflow/tfjs": "^4.22.0",
    "@upscalerjs/esrgan-slim": "^1.0.0",
    "onnxruntime-node": "1.24.3",
    "onnxruntime-web": "1.21.0",
    "upscaler": "^1.0.0",
    "vite": "6.1.0"
  },
  "devDependencies": {
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/syne": "^5.3.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "jsdom": "26.1.0",
    "@napi-rs/canvas": "0.1.80"
  },
  "version": "7.0.0",
  "description": "CUTOUT \u2014 Atelier image local",
  "author": "CUTOUT",
  "license": "AGPL-3.0-only",
  "main": "desktop/main.cjs",
  "build": {
    "appId": "studio.cutout.desktop",
    "productName": "CUTOUT",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/main.cjs",
      "desktop/preload.cjs",
      "desktop/store.cjs",
      "package.json",
      "!node_modules/**/*",
      "desktop/inference.cjs",
      "desktop/models.cjs",
      "desktop/generation.cjs",
      "desktop/generation-catalog.json"
    ],
    "extraResources": [
      {
        "from": "desktop-models",
        "to": "models"
      },
      {
        "from": "desktop-runtime",
        "to": "native"
      },
      {
        "from": "node-runtime/${os}-${arch}",
        "to": "node"
      },
      {
        "from": "desktop/inference.cjs",
        "to": "inference.cjs"
      },
      {
        "from": "generative-runtime/${os}-${arch}",
        "to": "generative"
      },
      {
        "from": "generative-models",
        "to": "generative-models"
      }
    ],
    "mac": {
      "category": "public.app-category.graphics-design",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "CUTOUT-${version}-macOS-${arch}.${ext}",
      "icon": "desktop/icon.png"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false,
      "artifactName": "CUTOUT-${version}-Windows-${arch}-Setup.${ext}",
      "icon": "desktop/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "npmRebuild": false
  },
  "packageManager": "pnpm@11.19.0"
}
